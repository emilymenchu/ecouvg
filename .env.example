# Marcadores: copiar a un archivo privado o al entorno del servidor.
# Copiar host, puerto y usuario de la MISMA opción de Connect en Supabase.
DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DB_USERNAME=USUARIO
DB_PASSWORD=CONTRASENA

# Storage utilizado por ServicioStorage (credenciales solo del servidor)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SECRET_KEY=CLAVE_SECRETA_DEL_SERVIDOR

GEMINI_API_KEY=CLAVE_GEMINI
GEMINI_MODELO=gemini-3.5-flash-lite
ECOUVG_MAIL_USERNAME=cuenta@example.com
ECOUVG_MAIL_PASSWORD=PASSWORD_DE_APLICACION_GMAIL

# En Vercel configurar también estos valores. La imagen ya usa prod y 8080.
PORT=8080
# SPRING_PROFILES_ACTIVE=prod
# DB_POOL_SIZE=3
